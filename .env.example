# Postgres connection used by Prisma when running on the host (docker compose overrides it for the api container).
# Uses the shared "postgres" container from jarvis-os-infra; the password is in ~/.config/postgres/password.
DATABASE_URL=postgresql://postgres:<password>@localhost:5432/youtube_channel_analyzer

# Google API key for the YouTube Data API v3. Server side only, never logged or returned.
YOUTUBE_API_KEY=

# Static client key callers send in the X-API-Key header. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CLIENT_API_KEY=

# Optional residential proxy for transcript requests. Not needed when running locally.
TRANSCRIPT_PROXY_URL=
